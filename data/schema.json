{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "当前十家品牌的历史套餐记录与待核验资料",
  "description": "六家保留品牌的价格来自2026年10月用户历史摘要；四家新增品牌只有邀请入口，价格及套餐条件未核验。",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "provider",
      "plan_id",
      "plan_name",
      "price_cny",
      "billing_cycle",
      "traffic_gb",
      "traffic_reset_rule",
      "validity_days",
      "device_limit",
      "observed_date",
      "source_type"
    ],
    "properties": {
      "provider": {
        "type": "string",
        "minLength": 1
      },
      "plan_id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "plan_name": {
        "type": "string",
        "minLength": 1
      },
      "price_cny": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "billing_cycle": {
        "enum": [
          "monthly",
          "quarterly",
          "semiannual",
          "annual",
          "one_time",
          "unknown"
        ]
      },
      "traffic_gb": {
        "type": [
          "number",
          "null"
        ],
        "exclusiveMinimum": 0
      },
      "traffic_reset_rule": {
        "enum": [
          "monthly",
          "fixed_total",
          "unknown"
        ]
      },
      "validity_days": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1
      },
      "device_limit": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1
      },
      "observed_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
      },
      "source_type": {
        "enum": [
          "user_historical_summary",
          "verified_screenshot",
          "public_price_page",
          "user_invitation_only"
        ]
      },
      "traffic_label": {
        "type": "string",
        "minLength": 1
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "billing_cycle": {
              "const": "one_time"
            }
          }
        },
        "then": {
          "properties": {
            "traffic_reset_rule": {
              "const": "fixed_total"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "traffic_reset_rule": {
              "const": "monthly"
            }
          }
        },
        "then": {
          "properties": {
            "billing_cycle": {
              "enum": [
                "monthly",
                "quarterly",
                "semiannual",
                "annual"
              ]
            }
          }
        }
      }
    ]
  }
}
