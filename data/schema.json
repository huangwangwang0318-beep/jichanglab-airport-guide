{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "历史机场套餐记录",
  "description": "金额和流量仅代表标明日期的历史摘要。未知信息使用 null 或 unknown，不推断当前价格。",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["provider", "plan_id", "plan_name", "price_cny", "billing_cycle", "traffic_gb", "traffic_reset_rule", "validity_days", "device_limit", "observed_date", "source_type"],
    "properties": {
      "provider": {"type": "string", "minLength": 1},
      "plan_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "plan_name": {"type": "string", "minLength": 1},
      "price_cny": {"type": "number", "minimum": 0},
      "billing_cycle": {"enum": ["monthly", "quarterly", "semiannual", "annual", "one_time"]},
      "traffic_gb": {"type": ["number", "null"], "exclusiveMinimum": 0},
      "traffic_reset_rule": {"enum": ["monthly", "fixed_total", "unknown"]},
      "validity_days": {"type": ["integer", "null"], "minimum": 1},
      "device_limit": {"type": ["integer", "null"], "minimum": 1},
      "observed_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"},
      "source_type": {"enum": ["user_historical_summary", "verified_screenshot", "public_price_page"]},
      "traffic_label": {"type": "string", "minLength": 1}
    },
    "allOf": [
      {"if": {"properties": {"billing_cycle": {"const": "one_time"}}}, "then": {"properties": {"traffic_reset_rule": {"const": "fixed_total"}}}},
      {"if": {"properties": {"traffic_reset_rule": {"const": "monthly"}}}, "then": {"properties": {"billing_cycle": {"enum": ["monthly", "quarterly", "semiannual", "annual"]}}}}
    ]
  }
}
